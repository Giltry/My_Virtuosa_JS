{
  "name": "virtuosa-js",
  "version": "1.0.0",
  "description": "Bot de musica para Discord en JavaScript. Usa yt-dlp como motor de audio.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "diagnostico": "node diagnostico.js",
    "supervisor": "node supervisor.js",
    "logs": "powershell -NoProfile -Command Get-Content logs/bot.log -Tail 40 -Wait",
    "inicio:instalar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/instalar-inicio.ps1",
    "inicio:desinstalar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desinstalar-inicio.ps1",
    "inicio:detener": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desinstalar-inicio.ps1 -SoloDetener",
    "inicio:arrancar": "powershell -NoProfile -Command Start-ScheduledTask -TaskName VirtuosaJS-Bot"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "libsodium-wrappers": "^0.8.4"
  },
  "license": "MIT",
  "private": true
}
